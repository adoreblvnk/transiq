# LTA DataMall API Credentials
LTA_ACCOUNT_KEY=your_lta_account_key_here
LTA_SDK_KEY=your_lta_sdk_key_here

# OneMap API Credentials (Optional: used for dynamic geocoding token refresh)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# PostgreSQL + PostGIS Database Configuration
POSTGRES_USER=transiq
POSTGRES_PASSWORD=transiq_secret
POSTGRES_DB=transiq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=transiq_secret

# Application & API Settings
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
